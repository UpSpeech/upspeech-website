# Early-access form (netlify/functions/early-access.ts)
#
# These are read by the Netlify function on the server, so they have no VITE_
# prefix and never reach the browser bundle. Set them in Netlify > Site
# configuration > Environment variables. `netlify dev` also reads them from a
# local .env, which is the only way to exercise the function locally.

# Resend API key. Without it the function answers 503 and sends nothing.
RESEND_API_KEY=

# Resend audience the applicant is added to, so the waitlist can be emailed
# later without exporting addresses. Unset means the contact write is skipped.
RESEND_AUDIENCE_ID=

# Apps Script web app deployed from the leads spreadsheet, plus the shared
# secret it checks. See netlify/lib/sheet-webhook.gs for the setup steps.
# Either one unset means the spreadsheet row is skipped.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# Optional. When set to an https:// URL, the applicant email grows a survey
# button. Leave empty and that whole block is left out.
EARLY_ACCESS_SURVEY_URL=

# Product Analytics (PostHog)
# The host is a same-origin tunnel (/relay-Qz4t, see netlify.toml + analytics.ts),
# not an env var, so ad-blockers can't drop it by domain.
VITE_POSTHOG_KEY=

# Backend API base URL. Used by src/lib/api.ts to fetch the techniques content
# that is prerendered into static HTML at build time. If this is unset, the app
# falls back to http://localhost:3050/api/v1, which is correct for local dev
# (run the backend) but FATAL for a production build: the techniques pages will
# render their error state and ship as broken HTML.
#
# Production (Netlify) MUST set this to the production backend, e.g.:
#   VITE_API_URL=https://app-backend-production-f30a.up.railway.app/api/v1
# (this host is already allow-listed in netlify.toml CSP connect-src)
VITE_API_URL=
